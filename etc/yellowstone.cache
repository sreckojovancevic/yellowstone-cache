# Yellowstone Cache konfiguracija

[cache]
# Globalni prekidac
enable = true

# Cache engine (lib/cache/<engine>.py)
engine = dmsetup

# Tip cache uredjaja:
#   ram    - RAM disk (brd modul), iskljucivo writethrough
#   device - postojeci block uredjaj (NVMe/SSD)
cache_type = ram

# Velicina RAM cache-a (cache_type = ram)
cache_ram = 12G

# Rezervisi svih cache_ram odmah pri up-u (dodir svake stranice).
# true  = memorija zauzeta unapred, vidljiva u htop odmah, bez rizika
#         kasnijeg OOM-a kad se kes zagreje (preporuceno)
# false = lenja alokacija (brd default), memorija raste sa punjenjem
ram_prealloc = true

# Minimum slobodne memorije koja mora ostati sistemu POSLE
# zauzimanja RAM cache-a
memory_headroom = 4G

# Block uredjaj za cache (cache_type = device)
cache_device =

# writethrough | writeback
# NAPOMENA: ram + writeback je zabranjena kombinacija (gubitak
# podataka pri nestanku struje) i alat je odbija.
cache_mode = writethrough

# Koliko sektora dm-cache sme da seli (promocije + democije) u
# jednom trenutku. Podrazumevano 2048 (1 MiB).
#
# Ovo je JEDINA poluga koju kernel daje za ponasanje kesa: smq
# politika ne izlaze nijedan parametar (`smq 0` u dmsetup status),
# pa se ne moze reci STA da ne useljava — ali se moze ograniciti
# KOLIKO BRZO useljava.
#
# Nize vrednosti (npr. 512) kocie useljavanje, pa sekvencijalni
# nalet — backup koji cita ceo disk, video tok, migracija — teze
# izbaci ono sto je stvarno vruce. Cena: kes sporije usvaja i ono
# sto BI trebalo da usvoji.
#
# Menjaj tek kad `status --delta` pokaze obrazac:
#   nizak hit ratio + visok promotion rate + obrt ispod 15 min
migration_threshold = 2048
